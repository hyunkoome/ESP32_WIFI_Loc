# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== 가상환경 (venv, conda 아님) =====
venv/
.venv/
env/             # 환경변수 파일 디렉터리(설정값)는 커밋 금지

# ===== 환경변수/비밀값 =====
.env
*.env
!*.env.example       # 예시 파일은 허용
# WiFi 자격증명이 주입된 빌드용 헤더(step01 이 config.yaml 에서 생성) — 비밀 포함
tools/board_check/firmware/main/wifi_credentials.h
# config.yaml 은 사용자 요청으로 commit 포함 (자격증명 포함 주의)
config.yaml.example  # 예시 파일

# ===== 진단 도구 산출물 =====
tools/board_check/results/

# ===== ESP-IDF 빌드 산출물 =====
build/
sdkconfig.old
# Component Manager 가 idf_component.yml + dependencies.lock 으로 자동 복원하므로 제외
managed_components/
*.bin
*.elf
*.map
# 재현성을 위해 sdkconfig(빌드 설정 고정) 와 dependencies.lock(컴포넌트 버전 고정) 은 커밋한다.
# 현재 이 둘을 무시하는 규칙은 없지만, 향후 광범위 패턴(예: *.lock)이 추가돼도
# 항상 추적되도록 명시적으로 허용해 둔다.
!sdkconfig
!dependencies.lock
# 단, YD-ESP32-S3 배포용 MicroPython 펌웨어 bin 은 자산이므로 포함(위 *.bin 예외)
!hw/YD-ESP32-S3/1-MPY-firmware/*.bin

# ===== 데이터/대용량 =====
volumes/
external/
archive/
*.csv
*.npy
*.npz
*.h5

# ===== OS / 에디터 =====
.DS_Store
.idea/
.vscode/
*.swp

# debug log
results/

# 참고용 외부 코드(esp-csi 등). 추적 안 함.
reference/
