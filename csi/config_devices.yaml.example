# esp32_device.yaml 템플릿 — 이 파일을 esp32_device.yaml 로 복사해 채우세요.
#   cp esp32_device.yaml.example esp32_device.yaml
#
# CSI 수집용 ESP32-S3 들의 tx/rx 역할 매핑.
# 자격증명이 아니므로(보드 식별용 serial 뿐) 안심하고 commit 해도 된다.
#
# 보드 serial 확인:
#   ls /dev/serial/by-id/
#   예) usb-1a86_USB_Single_Serial_XXXXXXXXXX-if00  → serial 은 XXXXXXXXXX
#
# 필드:
#   role   : tx → csi_send 펌웨어 / rx → csi_recv 펌웨어
#   serial : 위 by-id 의 <serial> 부분 (ttyACM 번호가 바뀌어도 안정적)
#   name   : 별칭(선택)
devices:
  - role: rx
    serial: "XXXXXXXXXX"
    name: "rx1"
  - role: tx
    serial: "YYYYYYYYYY"
    name: "tx1"
